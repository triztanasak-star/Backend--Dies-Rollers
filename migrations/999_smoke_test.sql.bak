-- 999_smoke_test.sql
-- Chay tay trong pgAdmin Query Tool sau khi da chay 001-006 de kiem tra nhanh.
-- KHONG chay tu dong trong code - day la script kiem thu thu cong.

-- 1) Kiem tra cac ban ghi digital_works chua khop duoc assigned_to sau migration 003
--    (assistant co ten nhung khong tim thay user trung ten -> can sua tay hoac tao user moi)
SELECT id, task_name, assistant, assigned_to
FROM "digital_works"
WHERE assistant IS NOT NULL AND assigned_to IS NULL;

-- 2) Kiem tra rang buoc FK hoat dong dung: insert 1 project + 1 user test + 1 digital_work
BEGIN;

INSERT INTO "users" (name, email, role, password_hash, status)
VALUES ('Test Manager', 'test.manager@example.com', 'manager', 'x', 'active')
RETURNING id;
-- ghi lai id tra ve, gia su la :manager_id

INSERT INTO "users" (name, email, role, password_hash, status)
VALUES ('Test User', 'test.user@example.com', 'user', 'x', 'active')
RETURNING id;
-- ghi lai id tra ve, gia su la :user_id

INSERT INTO "projects" (project_name, description, manager_id)
VALUES ('Du an test', 'Mo ta test', 1) -- doi 1 thanh :manager_id thuc te
RETURNING id;
-- ghi lai id tra ve, gia su la :project_id

INSERT INTO "digital_works" (task_name, project_id, assigned_to, created_by)
VALUES ('Task test', 1, 2, 1) -- doi so lieu cho khop id thuc te vua tao
RETURNING id;

INSERT INTO "task_plans" (work_id, created_by, step_name, step_order)
VALUES (1, 2, 'Buoc 1: chuan bi', 1) -- doi work_id cho khop
RETURNING id;

-- Neu tat ca INSERT o tren chay khong loi -> FK/constraint hoat dong dung.
-- Roi lai du lieu test:
ROLLBACK;

