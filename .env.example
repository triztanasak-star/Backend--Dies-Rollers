# === SERVER ===
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/pro_sale
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=15000

# === JWT ===
JWT_SECRET=change_me_min_32_chars_random_string
JWT_REFRESH_SECRET=change_me_min_32_chars_different_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === CORS ===
CORS_ORIGINS=http://localhost:5173

# === SECURITY ===
BCRYPT_ROUNDS=12
JSON_LIMIT=256kb

# === CLOUDINARY ===
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# === NOTIFICATIONS (Teams + Email) ===
# Link web app, đính kèm vào thông báo Teams/mail để bấm vào mở trực tiếp
APP_URL=https://digitalcpvn.vercel.app

# Incoming Webhook URL của channel Teams sẽ nhận thông báo
TEAMS_WEBHOOK_URL=

# Thông tin SMTP dùng để gửi email thông báo
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Danh sách email Manager nhận thông báo khi có dự án mới (phân tách bằng dấu phẩy)
MANAGER_NOTIFY_EMAILS=
